# Asthra 11.0: KeyBreak Cipher Clash - Environment Configuration
# NOTE: never commit real values. Copy this file to `.env` for local dev
# (`.env` is gitignored). In Vercel, set these under Project Settings ->
# Environment Variables and redeploy (Vite bakes VITE_* vars in at build time).

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon/public key (public by design; RLS policies are the real protection)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase URL (can be same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
# Server-only service role key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin passkey, verified SERVER-SIDE by api/admin-verify.ts.
# Server-only: NO VITE_ prefix so it never ships to the browser.
# In Vercel, add this as a Sensitive variable.
# REQUIRED in production — server will refuse admin access without it.
ADMIN_PASSKEY=your-secure-admin-passkey

# JWT secret for signing admin tokens (server-only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-at-least-32-chars

# Optional local-dev fallback only (used when /api/admin-verify is unreachable,
# e.g. plain `vite dev`). Prefer `vercel dev` so the real server check runs.
# VITE_ADMIN_PASSKEY=asthra11@admin
